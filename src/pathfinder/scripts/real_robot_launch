#!/usr/bin/env python3
"""Auto-detects connected robots and launches robots.launch accordingly."""
import subprocess
import sys

import rospkg
import yaml


def _arg_value(args: list[str], name: str) -> str | None:
    prefix = f'{name}:='
    for arg in args:
        if arg.startswith(prefix):
            return arg[len(prefix):]
    return None


def _default_robots_config() -> str:
    return f"{rospkg.RosPack().get_path('pathfinder')}/config/robots.yaml"


def _load_robot_ids(robots_config: str) -> list[str]:
    with open(robots_config, 'r') as robots_file:
        data = yaml.safe_load(robots_file)
    return [robot['id'] for robot in data['robots']]


def has_publishers(topic: str) -> bool:
    try:
        out = subprocess.check_output(['rostopic', 'info', topic],
                                      stderr=subprocess.DEVNULL, timeout=3).decode()
        for line in out.splitlines():
            if line.startswith('Publishers:'):
                return 'None' not in line and line.strip() != 'Publishers:'
    except Exception:
        return False
    return False


def build_roslaunch_command(args: list[str], has_publishers=has_publishers) -> list[str]:
    robots_config = _arg_value(args, 'robots_config') or _default_robots_config()
    robot_ids = _load_robot_ids(robots_config)
    passthrough_args = [arg for arg in args if not arg.startswith('active_robot_ids:=')]

    print('Checking connected robots...')
    active_robot_ids = []
    for robot_id in robot_ids:
        connected = has_publishers(f'/{robot_id}/scan')
        print(f'  {robot_id}: {"CONNECTED" if connected else "not found"}')
        if connected:
            active_robot_ids.append(robot_id)

    if not active_robot_ids:
        print('ERROR: No robots detected. Start robot bringup first.')
        sys.exit(1)

    return [
        'roslaunch', 'pathfinder', 'robots.launch',
        f'active_robot_ids:={",".join(active_robot_ids)}',
    ] + passthrough_args


def main():
    cmd = build_roslaunch_command(sys.argv[1:])
    print(f'Launching: {" ".join(cmd)}\n')
    subprocess.run(cmd)


if __name__ == '__main__':
    main()
