# Per-robot identity and hardware
LDS_MODEL=LDS-01
TURTLEBOT3_MODEL=waffle
ROS_NAMESPACE=tb3_05
ROS_HOSTNAME=192.168.0.22

# Catkin workspace that holds turtlebot3_bringup
CATKIN_WS=/home/ubuntu/catkin_ws

# Space-separated list of candidate masters; the wrapper picks the first reachable.
# Add more entries to support laptop/network fallback.
ROS_MASTER_CANDIDATES="http://192.168.0.4:11311 http://192.168.0.5:11311"

# Seconds between probe rounds
ROS_MASTER_PROBE_INTERVAL=3
