#!/usr/bin/env bash
set -euo pipefail

# /etc/default/turtlebot3 is already loaded via systemd's EnvironmentFile,
# but source it again here so the script works when invoked manually too.
if [[ -f /etc/default/turtlebot3 ]]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/default/turtlebot3
  set +a
fi

# ROS setup files reference unset vars (e.g. ROS_DISTRO) before defining them,
# which trips `set -u`. Disable nounset for the duration of the sourcing.
set +u
# shellcheck disable=SC1091
source /opt/ros/noetic/setup.bash
# shellcheck disable=SC1091
source "${CATKIN_WS:-/home/ubuntu/catkin_ws}/devel/setup.bash"
set -u

export LDS_MODEL TURTLEBOT3_MODEL ROS_NAMESPACE ROS_HOSTNAME

probe_master() {
  local uri="$1"
  local host_port="${uri#http://}"
  local host="${host_port%:*}"
  local port="${host_port##*:}"
  # Bash /dev/tcp is portable and dependency-free; succeeds only if the master is listening.
  (echo > "/dev/tcp/$host/$port") 2>/dev/null
}

INTERVAL="${ROS_MASTER_PROBE_INTERVAL:-3}"
while true; do
  for uri in ${ROS_MASTER_CANDIDATES:-}; do
    if probe_master "$uri"; then
      export ROS_MASTER_URI="$uri"
      echo "[turtlebot3-bringup] using master $uri (ns=$ROS_NAMESPACE, hostname=$ROS_HOSTNAME)"
      exec roslaunch turtlebot3_bringup turtlebot3_robot.launch \
        "/tf:=/${ROS_NAMESPACE}/raw_tf" \
        "/tf_static:=/${ROS_NAMESPACE}/raw_tf_static"
    fi
  done
  echo "[turtlebot3-bringup] no master reachable in: ${ROS_MASTER_CANDIDATES:-<empty>} — retrying in ${INTERVAL}s"
  sleep "$INTERVAL"
done
